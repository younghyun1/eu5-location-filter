import { Button, LineEdit, Palette } from "std-widgets.slint";
import { AboutDialog } from "about-dialog.slint";
import { AppHeader } from "header.slint";
import { DetailPane } from "detail-pane.slint";
import { FilterRail } from "filter-rail.slint";
import { ResultTable } from "result-table.slint";
import { CheckOption, ColumnSpec, DetailField, LocationRow } from "types.slint";
import { AppTheme } from "theme.slint";

component PaneHandle inherits Rectangle {
    width: 7px;
    height: 100%;
    callback dragged(length);
    background: transparent;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: drag-area.has-hover || drag-area.pressed ? 2px : 1px;
        height: 100%;
        background: drag-area.has-hover || drag-area.pressed ? AppTheme.handle-active : AppTheme.border;
    }
    drag-area := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-x - root.width / 2);
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "EU5 Location DB";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1050px;
    min-height: 680px;
    background: AppTheme.canvas;

    in property <[LocationRow]> rows;
    in property <[ColumnSpec]> columns;
    in property <float> table-width: 900;
    in property <string> sort-key: "name";
    in property <bool> sort-ascending: true;
    in-out property <string> search-text: "";
    in-out property <bool> show-impassable: true;
    in-out property <bool> food-producing-only: false;
    in-out property <bool> dark-theme <=> AppTheme.dark;
    property <float> theme-mix: root.dark-theme ? 1 : 0;
    animate theme-mix {
        duration: 90ms;
        easing: cubic-bezier(0.4, 0, 0.2, 1);
    }
    changed theme-mix => { AppTheme.mix = root.theme-mix; }
    in-out property <string> install-path: "";
    in property <bool> external-data-controls: true;
    in property <string> result-count: "0 locations";
    in property <string> build-text: "Build -";
    in property <bool> loading: true;
    in property <string> progress-stage: "Starting";
    in property <float> progress-value: 0;
    in property <string> error-text: "";
    in property <string> rgb-error: "";
    in property <string> numeric-error: "";
    in-out property <int> filter-reset-generation: 0;
    in-out property <bool> about-open: false;
    in-out property <bool> filter-pane-expanded: true;
    in-out property <bool> detail-pane-expanded: true;
    in-out property <int> selected-index: -1;
    in-out property <bool> window-maximized <=> root.maximized;
    in-out property <bool> window-full-screen <=> root.full-screen;

    in property <color> detail-color: AppTheme.raised;
    in property <string> detail-name: "Select a location";
    in property <string> detail-key: "";
    in property <string> detail-hex: "#000000";
    in property <string> detail-rgb: "rgb(0, 0, 0)";
    in property <string> detail-breadcrumb: "";
    in property <[DetailField]> detail-fields;

    in property <[CheckOption]> kind-options;
    in property <[CheckOption]> continent-options;
    in property <[CheckOption]> subcontinent-options;
    in property <[CheckOption]> region-options;
    in property <[CheckOption]> area-options;
    in property <[CheckOption]> province-options;
    in property <[CheckOption]> topography-options;
    in property <[CheckOption]> vegetation-options;
    in property <[CheckOption]> climate-options;
    in property <[CheckOption]> religion-options;
    in property <[CheckOption]> culture-options;
    in property <[CheckOption]> raw-material-options;
    in property <[CheckOption]> modifier-options;
    in property <[CheckOption]> coastal-options;
    in property <[CheckOption]> river-options;
    in property <[CheckOption]> river-level-options;
    in property <[CheckOption]> harbor-options;
    in property <[CheckOption]> movement-options;

    property <length> filter-pane-width: 270px;
    property <length> detail-pane-width: 350px;

    callback search-changed(string);
    callback toggle-impassable(bool);
    callback toggle-food-producing-only(bool);
    callback rgb-changed(string);
    callback numeric-changed(string, string);
    callback filter-options(string, string) -> [CheckOption];
    callback option-toggled(string, string, bool);
    callback clear-options(string);
    callback toggle-column(string, bool);
    callback resize-column(string, float);
    callback clear-filters;
    callback sort-requested(string);
    callback select-row(int);
    callback retry(string);
    callback rebuild(string);

    public function apply-theme(dark: bool) {
        root.dark-theme = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    VerticalLayout {
        spacing: 0px;
        AppHeader {
            search-text <=> root.search-text;
            result-count: root.result-count;
            build-text: root.build-text;
            search-changed(value) => { root.search-changed(value); }
            show-about => { root.about-open = true; }
        }
        HorizontalLayout {
            spacing: 0px;
            FilterRail {
                width: root.filter-pane-expanded ? root.filter-pane-width : 44px;
                expanded <=> root.filter-pane-expanded;
                show-impassable <=> root.show-impassable;
                food-producing-only <=> root.food-producing-only;
                rgb-error: root.rgb-error;
                numeric-error: root.numeric-error;
                reset-generation: root.filter-reset-generation;
                kind-options: root.kind-options;
                continent-options: root.continent-options;
                subcontinent-options: root.subcontinent-options;
                region-options: root.region-options;
                area-options: root.area-options;
                province-options: root.province-options;
                topography-options: root.topography-options;
                vegetation-options: root.vegetation-options;
                climate-options: root.climate-options;
                religion-options: root.religion-options;
                culture-options: root.culture-options;
                raw-material-options: root.raw-material-options;
                modifier-options: root.modifier-options;
                coastal-options: root.coastal-options;
                river-options: root.river-options;
                river-level-options: root.river-level-options;
                harbor-options: root.harbor-options;
                movement-options: root.movement-options;
                toggle-impassable(value) => { root.toggle-impassable(value); }
                toggle-food-producing-only(value) => { root.toggle-food-producing-only(value); }
                rgb-changed(value) => { root.rgb-changed(value); }
                numeric-changed(field, value) => { root.numeric-changed(field, value); }
                filter-options(field, query) => { return root.filter-options(field, query); }
                option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); }
                clear-options(field) => { root.clear-options(field); }
                clear-filters => { root.clear-filters(); }
                toggle-expanded(value) => { root.filter-pane-expanded = value; }
            }
            PaneHandle {
                visible: root.filter-pane-expanded;
                dragged(delta) => {
                    root.filter-pane-width = min(400px, max(245px, root.filter-pane-width + delta));
                }
            }
            ResultTable {
                rows: root.rows;
                columns: root.columns;
                table-width: root.table-width;
                sort-key: root.sort-key;
                sort-ascending: root.sort-ascending;
                detail-collapsed: !root.detail-pane-expanded;
                selected-index <=> root.selected-index;
                sort-requested(field) => { root.sort-requested(field); }
                select-row(index) => { root.select-row(index); }
                toggle-column(key, visible) => { root.toggle-column(key, visible); }
                resize-column(key, width) => { root.resize-column(key, width); }
                show-detail => { root.detail-pane-expanded = true; }
            }
            if root.detail-pane-expanded: PaneHandle {
                dragged(delta) => {
                    root.detail-pane-width = min(520px, max(280px, root.detail-pane-width - delta));
                }
            }
            if root.detail-pane-expanded: DetailPane {
                width: root.detail-pane-width;
                has-selection: root.selected-index >= 0;
                detail-color: root.detail-color;
                detail-name: root.detail-name;
                detail-key: root.detail-key;
                detail-hex: root.detail-hex;
                detail-rgb: root.detail-rgb;
                detail-breadcrumb: root.detail-breadcrumb;
                detail-fields: root.detail-fields;
                collapse => { root.detail-pane-expanded = false; }
            }
        }
    }

    if root.loading: Rectangle {
        background: AppTheme.overlay;
        z: 80;
        Rectangle {
            width: 440px;
            height: 116px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppTheme.dialog;
            border-color: AppTheme.border-strong;
            border-width: 1px;
            border-radius: 8px;
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                alignment: center;
                Text { text: root.progress-stage; color: AppTheme.text-primary; font-size: 16px; horizontal-alignment: center; }
                Rectangle {
                    height: 4px;
                    background: AppTheme.progress-track;
                    border-radius: 2px;
                    Rectangle {
                        width: parent.width * min(1, max(0, root.progress-value));
                        height: 100%;
                        background: AppTheme.progress-fill;
                        border-radius: 2px;
                    }
                }
            }
        }
    }
    if root.error-text != "": Rectangle {
        background: AppTheme.error-overlay;
        z: 90;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text { text: "Could not load EU5 locations"; color: AppTheme.error-title; font-size: 21px; horizontal-alignment: center; }
            Text { text: root.error-text; color: AppTheme.text-primary; width: 640px; wrap: word-wrap; horizontal-alignment: center; }
            if root.external-data-controls: VerticalLayout {
                alignment: center;
                spacing: 12px;
                LineEdit { text <=> root.install-path; placeholder-text: "Europa Universalis V installation directory"; width: 640px; }
                HorizontalLayout {
                    alignment: center;
                    Button { text: "Retry"; clicked => { root.retry(root.install-path); } }
                    Button { text: "Rebuild data"; clicked => { root.rebuild(root.install-path); } }
                }
            }
        }
    }
    if root.about-open: AboutDialog {
        z: 100;
        build-text: root.build-text;
        close => { root.about-open = false; }
    }
}
