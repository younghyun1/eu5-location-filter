import { CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { SearchableChecklist } from "searchable-checklist.slint";
import { CheckOption } from "types.slint";

component SectionTitle inherits Text {
    color: #8fbdea;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    vertical-alignment: center;
}

component FilterGroup inherits VerticalLayout {
    in property <string> label;
    in property <[CheckOption]> options;
    callback filter-options(string, string) -> [CheckOption];
    callback option-toggled(string, string, bool);
    callback clear-options(string);
    in property <int> reset-generation: 0;
    spacing: 3px;
    Text { text: root.label; color: #aeb8c5; font-size: 12px; }
    checklist := SearchableChecklist {
        field: root.label;
        options: root.options;
        reset-generation: root.reset-generation;
        filter-options(field, query) => { return root.filter-options(field, query); }
        option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); }
        clear-options(field) => { root.clear-options(field); }
    }
}

export component FilterRail inherits Rectangle {
    background: #151c25;
    border-color: #2b3948;
    border-width: 1px;
    in-out property <bool> show-impassable: true;
    in property <string> rgb-error: "";
    in property <string> numeric-error: "";
    in property <int> reset-generation: 0;
    in property <[CheckOption]> kind-options;
    in property <[CheckOption]> continent-options;
    in property <[CheckOption]> subcontinent-options;
    in property <[CheckOption]> region-options;
    in property <[CheckOption]> area-options;
    in property <[CheckOption]> province-options;
    in property <[CheckOption]> topography-options;
    in property <[CheckOption]> vegetation-options;
    in property <[CheckOption]> climate-options;
    in property <[CheckOption]> religion-options;
    in property <[CheckOption]> culture-options;
    in property <[CheckOption]> raw-material-options;
    in property <[CheckOption]> modifier-options;
    in property <[CheckOption]> coastal-options;
    in property <[CheckOption]> river-options;
    in property <[CheckOption]> river-level-options;
    in property <[CheckOption]> harbor-options;
    in property <[CheckOption]> movement-options;
    callback toggle-impassable(bool);
    callback rgb-changed(string);
    callback numeric-changed(string, string);
    callback filter-options(string, string) -> [CheckOption];
    callback option-toggled(string, string, bool);
    callback clear-options(string);

    ScrollView {
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 14px;
            spacing: 9px;
            SectionTitle { text: "VISIBILITY"; height: 24px; }
            CheckBox {
                text: "Show impassable";
                checked <=> root.show-impassable;
                toggled => { root.toggle-impassable(self.checked); }
            }
            kind-group := FilterGroup { label: "Kind"; options: root.kind-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            SectionTitle { text: "GEOGRAPHY"; height: 30px; }
            continent-group := FilterGroup { label: "Continent"; options: root.continent-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            subcontinent-group := FilterGroup { label: "Subcontinent"; options: root.subcontinent-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            region-group := FilterGroup { label: "Region"; options: root.region-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            area-group := FilterGroup { label: "Area"; options: root.area-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            province-group := FilterGroup { label: "Province"; options: root.province-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            SectionTitle { text: "TERRAIN & ENVIRONMENT"; height: 30px; }
            topography-group := FilterGroup { label: "Topography"; options: root.topography-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            vegetation-group := FilterGroup { label: "Vegetation"; options: root.vegetation-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            climate-group := FilterGroup { label: "Climate"; options: root.climate-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            religion-group := FilterGroup { label: "Religion"; options: root.religion-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            culture-group := FilterGroup { label: "Culture"; options: root.culture-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            raw-material-group := FilterGroup { label: "Raw material"; options: root.raw-material-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            modifier-group := FilterGroup { label: "Modifier"; options: root.modifier-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            SectionTitle { text: "MAP DATA"; height: 30px; }
            Text { text: "RGB"; color: #aeb8c5; font-size: 12px; }
            rgb-input := LineEdit { placeholder-text: "#RRGGBB"; edited(value) => { root.rgb-changed(value); } }
            Text { text: root.rgb-error; color: #ff8d8d; font-size: 11px; visible: root.rgb-error != ""; }
            coastal-group := FilterGroup { label: "Coastal"; options: root.coastal-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            river-group := FilterGroup { label: "River"; options: root.river-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            river-min-group := FilterGroup { label: "Min river level"; options: root.river-level-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            river-max-group := FilterGroup { label: "Max river level"; options: root.river-level-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            harbor-group := FilterGroup { label: "Harbor suitability"; options: root.harbor-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            HorizontalLayout { spacing: 6px; harbor-min-input := LineEdit { placeholder-text: "Minimum"; input-type: decimal; edited(value) => { root.numeric-changed("harbor-min", value); } } harbor-max-input := LineEdit { placeholder-text: "Maximum"; input-type: decimal; edited(value) => { root.numeric-changed("harbor-max", value); } } }
            movement-group := FilterGroup { label: "Movement assistance"; options: root.movement-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
            HorizontalLayout { spacing: 6px; move-x-min-input := LineEdit { placeholder-text: "X minimum"; input-type: decimal; edited(value) => { root.numeric-changed("move-x-min", value); } } move-x-max-input := LineEdit { placeholder-text: "X maximum"; input-type: decimal; edited(value) => { root.numeric-changed("move-x-max", value); } } }
            HorizontalLayout { spacing: 6px; move-y-min-input := LineEdit { placeholder-text: "Y minimum"; input-type: decimal; edited(value) => { root.numeric-changed("move-y-min", value); } } move-y-max-input := LineEdit { placeholder-text: "Y maximum"; input-type: decimal; edited(value) => { root.numeric-changed("move-y-max", value); } } }
            Text { text: root.numeric-error; color: #ff8d8d; font-size: 11px; visible: root.numeric-error != ""; }
        }
    }

    changed reset-generation => {
        rgb-input.text = ""; harbor-min-input.text = ""; harbor-max-input.text = "";
        move-x-min-input.text = ""; move-x-max-input.text = ""; move-y-min-input.text = ""; move-y-max-input.text = "";
    }
}
