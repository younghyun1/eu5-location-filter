import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { SearchableChecklist } from "searchable-checklist.slint";
import { CheckOption } from "types.slint";
import { AppTheme } from "theme.slint";

component SectionTitle inherits Text {
    color: AppTheme.accent;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    vertical-alignment: center;
}

component RangeLineEdit inherits LineEdit {
    min-width: 0px;
    horizontal-stretch: 1;
    input-type: decimal;
}

component FilterGroup inherits VerticalLayout {
    in property <string> label;
    in property <[CheckOption]> options;
    callback filter-options(string, string) -> [CheckOption];
    callback option-toggled(string, string, bool);
    callback clear-options(string);
    in property <int> reset-generation: 0;
    property <bool> expanded: true;
    spacing: 3px;
    min-width: 0px;
    horizontal-stretch: 1;
    HorizontalLayout {
        height: 26px;
        Text { text: root.label; color: AppTheme.text-muted; font-size: 12px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: 28px;
            height: 100%;
            Button {
                width: 26px;
                height: 24px;
                x: 1px;
                y: (parent.height - self.height) / 2;
                text: root.expanded ? "-" : "+";
                accessible-label: (root.expanded ? "Collapse " : "Expand ") + root.label;
                clicked => { root.expanded = !root.expanded; }
            }
        }
    }
    if root.expanded: SearchableChecklist {
        field: root.label;
        options: root.options;
        reset-generation: root.reset-generation;
        filter-options(field, query) => { return root.filter-options(field, query); }
        option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); }
        clear-options(field) => { root.clear-options(field); }
    }
}

export component FilterRail inherits Rectangle {
    background: AppTheme.panel;
    border-color: AppTheme.border;
    border-width: 1px;
    in-out property <bool> expanded: true;
    in-out property <bool> show-impassable: true;
    in-out property <bool> food-producing-only: false;
    in property <string> rgb-error: "";
    in property <string> numeric-error: "";
    in property <int> reset-generation: 0;
    in property <[CheckOption]> kind-options;
    in property <[CheckOption]> continent-options;
    in property <[CheckOption]> subcontinent-options;
    in property <[CheckOption]> region-options;
    in property <[CheckOption]> area-options;
    in property <[CheckOption]> province-options;
    in property <[CheckOption]> topography-options;
    in property <[CheckOption]> vegetation-options;
    in property <[CheckOption]> climate-options;
    in property <[CheckOption]> religion-options;
    in property <[CheckOption]> culture-options;
    in property <[CheckOption]> raw-material-options;
    in property <[CheckOption]> modifier-options;
    in property <[CheckOption]> coastal-options;
    in property <[CheckOption]> river-options;
    in property <[CheckOption]> river-level-options;
    in property <[CheckOption]> harbor-options;
    in property <[CheckOption]> movement-options;
    property <string> rgb-text: "";
    property <string> harbor-min-text: "";
    property <string> harbor-max-text: "";
    property <string> move-x-min-text: "";
    property <string> move-x-max-text: "";
    property <string> move-y-min-text: "";
    property <string> move-y-max-text: "";
    callback toggle-impassable(bool);
    callback toggle-food-producing-only(bool);
    callback rgb-changed(string);
    callback numeric-changed(string, string);
    callback filter-options(string, string) -> [CheckOption];
    callback option-toggled(string, string, bool);
    callback clear-options(string);
    callback clear-filters;
    callback toggle-expanded(bool);

    if root.expanded: VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 42px;
            background: AppTheme.raised;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 6px;
                SectionTitle { text: "VISIBILITY"; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 56px;
                    height: 100%;
                    Button {
                        width: 56px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        text: "Clear";
                        clicked => { root.clear-filters(); }
                    }
                }
                Rectangle {
                    width: 30px;
                    height: 100%;
                    Button {
                        width: 30px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        text: "<";
                        accessible-label: "Collapse filters";
                        clicked => { root.toggle-expanded(false); }
                    }
                }
            }
        }
        filter-scroll := ScrollView {
            viewport-x: 0px;
            viewport-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                width: filter-scroll.visible-width;
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 14px;
                spacing: 9px;
                CheckBox {
                    text: "Show impassable";
                    checked <=> root.show-impassable;
                    toggled => { root.toggle-impassable(self.checked); }
                }
                FilterGroup { label: "Type"; options: root.kind-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                SectionTitle { text: "GEOGRAPHY"; height: 30px; }
                FilterGroup { label: "Continent"; options: root.continent-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Subcontinent"; options: root.subcontinent-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Region"; options: root.region-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Area"; options: root.area-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Province"; options: root.province-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                SectionTitle { text: "TERRAIN & ENVIRONMENT"; height: 30px; }
                FilterGroup { label: "Topography"; options: root.topography-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Vegetation"; options: root.vegetation-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Climate"; options: root.climate-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Religion"; options: root.religion-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Culture"; options: root.culture-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Raw material"; options: root.raw-material-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                CheckBox {
                    text: "Food-producing only";
                    checked <=> root.food-producing-only;
                    toggled => { root.toggle-food-producing-only(self.checked); }
                }
                FilterGroup { label: "Modifier"; options: root.modifier-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                SectionTitle { text: "MAP DATA"; height: 30px; }
                Text { text: "RGB"; color: AppTheme.text-muted; font-size: 12px; }
                LineEdit { text <=> root.rgb-text; placeholder-text: "#RRGGBB"; edited(value) => { root.rgb-changed(value); } }
                Text { text: root.rgb-error; color: AppTheme.error; font-size: 11px; visible: root.rgb-error != ""; }
                FilterGroup { label: "Coastal"; options: root.coastal-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "River"; options: root.river-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Min river bonus"; options: root.river-level-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Max river bonus"; options: root.river-level-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                FilterGroup { label: "Harbor suitability"; options: root.harbor-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                HorizontalLayout { spacing: 6px; RangeLineEdit { text <=> root.harbor-min-text; placeholder-text: "Minimum"; edited(value) => { root.numeric-changed("harbor-min", value); } } RangeLineEdit { text <=> root.harbor-max-text; placeholder-text: "Maximum"; edited(value) => { root.numeric-changed("harbor-max", value); } } }
                FilterGroup { label: "Movement assistance"; options: root.movement-options; reset-generation: root.reset-generation; filter-options(field, query) => { return root.filter-options(field, query); } option-toggled(field, key, checked) => { root.option-toggled(field, key, checked); } clear-options(field) => { root.clear-options(field); } }
                HorizontalLayout { spacing: 6px; RangeLineEdit { text <=> root.move-x-min-text; placeholder-text: "X minimum"; edited(value) => { root.numeric-changed("move-x-min", value); } } RangeLineEdit { text <=> root.move-x-max-text; placeholder-text: "X maximum"; edited(value) => { root.numeric-changed("move-x-max", value); } } }
                HorizontalLayout { spacing: 6px; RangeLineEdit { text <=> root.move-y-min-text; placeholder-text: "Y minimum"; edited(value) => { root.numeric-changed("move-y-min", value); } } RangeLineEdit { text <=> root.move-y-max-text; placeholder-text: "Y maximum"; edited(value) => { root.numeric-changed("move-y-max", value); } } }
                Text { text: root.numeric-error; color: AppTheme.error; font-size: 11px; visible: root.numeric-error != ""; }
            }
        }
    }
    if !root.expanded: Button {
        x: 7px;
        y: 10px;
        width: 30px;
        height: 30px;
        text: ">";
        accessible-label: "Expand filters";
        clicked => { root.toggle-expanded(true); }
    }

    changed reset-generation => {
        root.rgb-text = ""; root.harbor-min-text = ""; root.harbor-max-text = "";
        root.move-x-min-text = ""; root.move-x-max-text = ""; root.move-y-min-text = ""; root.move-y-max-text = "";
    }
}
