import { LineEdit, ListView } from "std-widgets.slint";

export component SearchableComboBox inherits Rectangle {
    height: 32px;
    preferred-width: 220px;
    min-width: 150px;
    max-width: 235px;
    horizontal-stretch: 0;
    background: #232b36;
    border-color: open-area.has-hover || open-area.pressed ? #6aa9db : #354250;
    border-width: 1px;
    border-radius: 3px;

    in property <string> field;
    in property <[string]> options;
    in-out property <string> current-value: "Any";
    property <[string]> filtered-options: root.options;
    property <string> query: "";
    callback selected(string);
    callback filter-options(string, string) -> [string];

    Text {
        x: 10px;
        width: parent.width - 34px;
        height: 100%;
        text: root.current-value;
        color: #e0e7ee;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 24px;
        width: 14px;
        height: 100%;
        text: "v";
        color: #8fa0b1;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    open-area := TouchArea {
        accessible-role: combobox;
        accessible-label: root.field + " filter";
        accessible-value: root.current-value;
        mouse-cursor: pointer;
        clicked => {
            root.query = "";
            root.filtered-options = root.filter-options(root.field, "");
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: max(root.width, 260px);
        height: min(330px, max(92px, root.filtered-options.length * 34px + 52px));
        close-policy: close-on-click-outside;
        forward-focus: search-input;
        Rectangle {
            background: #1b232d;
            border-color: #516376;
            border-width: 1px;
            border-radius: 4px;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                search-input := LineEdit {
                    height: 34px;
                    text <=> root.query;
                    placeholder-text: "Search options";
                    accessible-label: "Search " + root.field + " options";
                    edited(value) => {
                        root.filtered-options = root.filter-options(root.field, value);
                    }
                }
                ListView {
                    for option in root.filtered-options: Rectangle {
                        height: 34px;
                        background: option-area.has-hover ? #2c3b4b : transparent;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: option;
                            color: #e0e7ee;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        option-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current-value = option;
                                root.selected(option);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
