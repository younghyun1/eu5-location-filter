import { ScrollView } from "std-widgets.slint";
import { DetailField } from "types.slint";
import { AppTheme } from "theme.slint";

export component DetailPane inherits Rectangle {
    background: AppTheme.panel;
    border-color: AppTheme.border;
    border-width: 1px;
    in property <bool> has-selection;
    in property <color> detail-color;
    in property <string> detail-name;
    in property <string> detail-key;
    in property <string> detail-hex;
    in property <string> detail-rgb;
    in property <string> detail-breadcrumb;
    in property <[DetailField]> detail-fields;

    if !root.has-selection: VerticalLayout {
        alignment: center;
        padding: 28px;
        spacing: 8px;
        Text { text: "Select a location"; color: AppTheme.text-primary; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "Location details, hierarchy, color, and river data appear here."; color: AppTheme.text-subtle; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
    }
    if root.has-selection: ScrollView {
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Rectangle {
                height: 108px;
                background: root.detail-color;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppTheme.swatch-border;
            }
            Text { text: root.detail-name; color: AppTheme.text-primary; font-size: 20px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.detail-key; color: AppTheme.text-muted; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                Text { text: root.detail-hex; color: AppTheme.text-secondary; font-size: 13px; }
                Text { text: root.detail-rgb; color: AppTheme.text-secondary; font-size: 13px; horizontal-alignment: right; }
            }
            Rectangle { height: 1px; background: AppTheme.divider; }
            Text { text: root.detail-breadcrumb; color: AppTheme.accent-text; font-size: 12px; wrap: word-wrap; }
            for field in root.detail-fields: VerticalLayout {
                spacing: 2px;
                Text { text: field.label; color: AppTheme.text-subtle; font-size: 11px; font-weight: 600; }
                Text { text: field.value; color: AppTheme.text-secondary; font-size: 13px; wrap: word-wrap; }
            }
        }
    }
}
