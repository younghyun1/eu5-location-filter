import { CheckBox, LineEdit, ListView } from "std-widgets.slint";
import { CheckOption } from "types.slint";
import { AppTheme } from "theme.slint";

export component SearchableChecklist inherits VerticalLayout {
    in property <string> field;
    in property <[CheckOption]> options;
    in-out property <[CheckOption]> filtered-options: root.options;
    in-out property <string> query: "";
    in property <int> reset-generation: 0;
    property <length> list-height: min(170px, max(68px, root.filtered-options.length * 30px));
    callback filter-options(string, string) -> [CheckOption];
    callback option-toggled(string, string, bool);
    callback clear-options(string);
    spacing: 4px;
    horizontal-stretch: 1;
    min-width: 0px;
    LineEdit {
        height: 30px;
        horizontal-stretch: 1;
        min-width: 0px;
        text <=> root.query;
        placeholder-text: "Search " + root.field.to-lowercase();
        accessible-label: "Search " + root.field + " options";
        edited(value) => {
            root.filtered-options = root.filter-options(root.field, value);
        }
    }
    Rectangle {
        height: root.list-height;
        horizontal-stretch: 1;
        clip: true;
        background: AppTheme.recessed;
        border-color: AppTheme.border;
        border-width: 1px;
        border-radius: 3px;
        ListView {
            x: 5px;
            width: parent.width - 10px;
            viewport-x: 0px;
            viewport-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            for option in root.filtered-options: CheckBox {
                width: root.width - 12px;
                height: 30px;
                text: option.label;
                checked: option.checked;
                toggled => {
                    root.option-toggled(root.field, option.key, self.checked);
                    root.filtered-options = root.filter-options(root.field, root.query);
                }
            }
        }
    }

    changed reset-generation => {
        root.query = "";
        root.filtered-options = root.filter-options(root.field, "");
    }
}
