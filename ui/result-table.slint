import { Button, CheckBox, ListView, ScrollView } from "std-widgets.slint";
import { ColumnSpec, LocationRow } from "types.slint";
import { AppTheme } from "theme.slint";

component ColumnHandle inherits Rectangle {
    width: 1px;
    height: 100%;
    in property <length> target-width;
    callback resized(length);
    background: drag-area.has-hover || drag-area.pressed ? AppTheme.handle-active : AppTheme.handle;
    drag-area := TouchArea {
        x: -4px;
        width: 9px;
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.resized(max(54px, root.target-width + self.mouse-x - self.pressed-x));
            }
        }
    }
}

export component ResultTable inherits VerticalLayout {
    in property <[LocationRow]> rows;
    in property <[ColumnSpec]> columns;
    in property <float> table-width;
    in property <string> sort-key;
    in property <bool> sort-ascending;
    in-out property <int> selected-index: -1;
    callback sort-requested(string);
    callback select-row(int);
    callback toggle-column(string, bool);
    callback resize-column(string, float);
    spacing: 0px;
    min-width: 420px;
    horizontal-stretch: 1;

    function cell-text(row: LocationRow, key: string) -> string {
        if (key == "name") { return row.name; }
        if (key == "identifier") { return row.key; }
        if (key == "kind") { return row.kind; }
        if (key == "topography") { return row.topography; }
        if (key == "vegetation") { return row.vegetation; }
        if (key == "climate") { return row.climate; }
        if (key == "continent") { return row.continent; }
        if (key == "subcontinent") { return row.subcontinent; }
        if (key == "region") { return row.region; }
        if (key == "area") { return row.area; }
        if (key == "province") { return row.province; }
        if (key == "religion") { return row.religion; }
        if (key == "culture") { return row.culture; }
        if (key == "raw_material") { return row.raw-material; }
        if (key == "modifier") { return row.modifier; }
        if (key == "rgb") { return row.rgb; }
        if (key == "coastal") { return row.coastal; }
        if (key == "river_presence") { return row.river-presence; }
        if (key == "river_level") { return row.river-level; }
        if (key == "harbor") { return row.harbor; }
        if (key == "movement_presence") { return row.movement-presence; }
        if (key == "movement_x") { return row.movement-x; }
        if (key == "movement_y") { return row.movement-y; }
        if (key == "static_capacity") { return row.static-capacity; }
        if (key == "equator_capacity") { return row.equator-capacity; }
        return "";
    }

    function pan-horizontal(delta: length) {
        table.viewport-x = max(
            min(0px, table.visible-width - table.viewport-width),
            min(0px, table.viewport-x + delta)
        );
    }

    Rectangle {
        height: 36px;
        background: AppTheme.toolbar;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            Text {
                text: "RESULT COLUMNS";
                color: AppTheme.text-subtle;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "Food-producing";
                color: AppTheme.food;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: "Gold / silver";
                color: AppTheme.accent;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle {
                width: 88px;
                height: 100%;
                Button {
                    width: 100%;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    text: "Columns";
                    clicked => { column-popup.show(); }
                }
            }
        }
    }
    Rectangle {
        height: 44px;
        background: AppTheme.raised;
        clip: true;
        HorizontalLayout {
            x: table.viewport-x;
            width: root.table-width * 1px;
            padding-left: 10px;
            spacing: 0px;
            for column in root.columns: Rectangle {
                visible: column.visible;
                width: column.visible ? column.width * 1px : 0px;
                clip: true;
                Button {
                    x: 3px;
                    width: column.width * 1px - 7px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    text: "";
                    accessible-label: column.label;
                    clicked => { root.sort-requested(column.key); }
                }
                Text {
                    x: 8px;
                    width: column.width * 1px - (root.sort-key == column.key ? 30px : 16px);
                    height: 100%;
                    text: column.label;
                    color: AppTheme.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    visible: root.sort-key == column.key;
                    x: column.width * 1px - 22px;
                    width: 12px;
                    height: 100%;
                    text: root.sort-ascending ? "^" : "v";
                    color: AppTheme.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ColumnHandle {
                    x: column.width * 1px - 1px;
                    target-width: column.width * 1px;
                    resized(value) => { root.resize-column(column.key, value / 1px); }
                }
            }
        }
    }
    table := ListView {
        viewport-width: max(self.visible-width, root.table-width * 1px);
        horizontal-scrollbar-policy: as-needed;
        for row[index] in root.rows: Rectangle {
            width: root.table-width * 1px;
            height: 62px;
            background: root.selected-index == index ? AppTheme.row-selected
                : (Math.mod(index, 2) == 0 ? AppTheme.row-even : AppTheme.row-odd);
            HorizontalLayout {
                padding-left: 10px;
                spacing: 0px;
                for column in root.columns: Rectangle {
                    visible: column.visible;
                    width: column.visible ? column.width * 1px : 0px;
                    clip: true;
                    if column.key == "color": HorizontalLayout {
                        x: 4px;
                        width: column.width * 1px - 9px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 7px;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: AppTheme.swatch-border;
                            background: row.color;
                        }
                        Text {
                            text: row.hex;
                            color: AppTheme.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if column.key != "color": Rectangle {
                        width: column.width * 1px - 1px;
                        height: 100%;
                        Text {
                            x: column.key == "name" || column.key == "identifier" ? 8px : 4px;
                            width: parent.width - (column.key == "name" || column.key == "identifier" ? 12px : 8px);
                            height: 100%;
                            text: root.cell-text(row, column.key);
                            color: column.key == "raw_material" && row.food-raw-material ? AppTheme.food
                                : column.key == "raw_material" && row.precious-raw-material ? AppTheme.accent
                                : column.key == "river_level" ? AppTheme.accent-text
                                : AppTheme.text-secondary;
                            font-size: column.key == "name" ? 14px : 12px;
                            font-weight: column.key == "name" ? 600 : 400;
                            horizontal-alignment: column.key == "name" || column.key == "identifier" ? left : center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        x: column.width * 1px - 1px;
                        width: 1px;
                        height: 100%;
                        background: AppTheme.divider;
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: AppTheme.divider-muted;
            }
            row-touch := TouchArea {
                property <bool> middle-panning: false;
                property <length> previous-window-x: 0px;
                accessible-role: list-item;
                accessible-label: row.name + ", " + row.key;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.down) {
                        self.middle-panning = true;
                        self.previous-window-x = self.absolute-position.x + self.mouse-x;
                    }
                    if (event.button == PointerEventButton.middle
                        && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)) {
                        self.middle-panning = false;
                    }
                }
                moved => {
                    if (self.middle-panning) {
                        // Window coordinates keep the drag speed independent of the moving row content.
                        root.pan-horizontal(self.absolute-position.x + self.mouse-x - self.previous-window-x);
                        self.previous-window-x = self.absolute-position.x + self.mouse-x;
                    }
                }
                scroll-event(event) => {
                    if (event.modifiers.shift && event.delta-y != 0px) {
                        root.pan-horizontal(event.delta-y);
                        return accept;
                    }
                    reject
                }
                clicked => { root.selected-index = index; root.select-row(index); }
            }
        }
    }

    column-popup := PopupWindow {
        x: root.width - 260px;
        y: 36px;
        width: 250px;
        height: min(520px, root.columns.length * 34px + 52px);
        close-policy: no-auto-close;
        Rectangle {
            background: AppTheme.popup;
            border-color: AppTheme.border-strong;
            border-width: 1px;
            border-radius: 4px;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: "Visible columns"; color: AppTheme.text-primary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Close"; width: 64px; height: 30px; clicked => { column-popup.close(); } }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 2px;
                        for column in root.columns: CheckBox {
                            text: column.label;
                            checked: column.visible;
                            toggled => { root.toggle-column(column.key, self.checked); }
                        }
                    }
                }
            }
        }
    }
}
